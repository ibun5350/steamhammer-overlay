function createPopUpScroll()
{
   %gui = new GuiScrollCtrl()
   {
      hScrollBar = "alwaysOff";
      horizSizing = "width";
      vertSizing = "height";
      profile = "GuiScrollSkillInfoProfile";
      tooltipProfile = "GuiToolTipProfile";
      constantThumbHeight = true;
      childMargin = "0 0";
      trackOffset = 8;
      lockHorizScroll = true;
      arrowSadowSize = 7;
      addContentWidth = 27;
   };
   return %gui;
}
