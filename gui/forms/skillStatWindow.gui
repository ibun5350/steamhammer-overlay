//-----------------------------------------------------------------------------

function GuiSkillStatWindow::onWake( %this) 
{
   loadObjectPropertyXml(%this, "SkillStatWindow");

   %skill_info = createSkillInfo();
   GuiSkillInfoPanel.add(%skill_info);
   if ($pref::Skills::curGroup == 1)
   {
      showCraftSkill();
      ShowCraftSkillBtn.setStateOn(true);
   }
   else if ($pref::Skills::curGroup == 2)
   {
      showCombatSkill();
      showCombatSkillBtn.setStateOn(true);
   }
   else if ($pref::Skills::curGroup == 3)
   {
      showMinorSkill();
      showMinorSkillBtn.setStateOn(true);
   }

   GuiStrengthLockBtn.initTooltip(805, 806, 807);
   GuiAgilityLockBtn.initTooltip(805, 806, 807);
   GuiConstitutionLockBtn.initTooltip(805, 806, 807);
   GuiIntellectLockBtn.initTooltip(805, 806, 807);
   GuiWillpowerLockBtn.initTooltip(805, 806, 807);

   GuiNameTextCtrl.text = getFirstName() SPC getLastName();
}
//-----------------------------------------------------------------------------

function GuiSkillStatWindow::onSleep( %this) 
{
   saveObjectPropertyXml(%this, "SkillStatWindow");
}
//-----------------------------------------------------------------------------

function GuiSkillStatWindow::onClose( %this) 
{
   closeSkillStatDlg();
}
//-----------------------------------------------------------------------------
